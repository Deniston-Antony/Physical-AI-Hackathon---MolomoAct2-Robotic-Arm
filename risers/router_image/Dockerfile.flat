# The router image flattened: the same files as denistonantony/policy-router:v1 (Dockerfile), without the build
# cache that the FLUX base image deletes in a later layer but still counts against the 55 GB unpacked budget.
FROM denistonantony/policy-router:v1 AS clean
RUN rm -rf /root/.cache
FROM clean AS rest
RUN rm -rf /opt/hf-home /opt/flux-action /opt/molmobot /v3
FROM scratch
COPY --from=rest / /
COPY --from=clean /opt/hf-home /opt/hf-home
COPY --from=clean /opt/flux-action /opt/flux-action
COPY --from=clean /opt/molmobot /opt/molmobot
COPY --from=clean /v3 /v3
ENV PATH=/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin \
    LANG=C.UTF-8 PYTHON_VERSION=3.12.16 HF_HOME=/opt/hf-home \
    FLUX_POLICY_REPO=black-forest-labs/flux-3-action-droid \
    FLUX_POLICY_REVISION=3d0887bdc7acee1686b19afac267125d519ff4f1 \
    FLUX_POLICY_SUBFOLDER=variants/gd PYTHONUNBUFFERED=1 \
    PYTHONPATH=/positronic:/positronic/client:/positronic/wire:/positronic/model_server:/positronic/vocabulary:/positronic/evals \
    UV_PROJECT_ENVIRONMENT=/positronic/.venv UV_LINK_MODE=copy UV_HTTP_TIMEOUT=600 \
    HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 UV_OFFLINE=1 UV_NO_SYNC=1 \
    NVIDIA_VISIBLE_DEVICES=all NVIDIA_DRIVER_CAPABILITIES=compute,utility
WORKDIR /positronic
EXPOSE 8000
ENTRYPOINT ["/usr/local/bin/python3.12", "/router/front.py"]
