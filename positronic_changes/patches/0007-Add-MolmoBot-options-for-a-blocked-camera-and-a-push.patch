+def detail(img: np.ndarray) -> float:
+    """The mean grey gradient of an image: low for a camera that faces a wall or a dark corner."""
+    grey = np.asarray(img, dtype=np.float32).mean(axis=2)
+    return float((np.abs(np.diff(grey, axis=0)).mean() + np.abs(np.diff(grey, axis=1)).mean()) / 2)
+
+
+def push_direction(joints: np.ndarray, attempt: int) -> np.ndarray:
+    """A level unit push direction in the base frame: the gripper axis, or away from the base on odd attempts."""
+    pose = arm.gripper_pose(joints)
+    axis, away = pose[:3, 2].copy(), pose[:3, 3].copy()
+    use_axis = attempt % 2 == 0 and abs(axis[2]) < _STEEP_AXIS
+    direction = axis if use_axis else away
+    direction[2] = 0.0
+    return direction / max(float(np.linalg.norm(direction)), 1e-6)
+
